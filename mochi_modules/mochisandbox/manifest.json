{
  "name": "mochisandbox",
  "version": "0.1.0",
  "type": "native-engine-plugin",
  "description": "Realm-isolated sandbox runtime (create/run/runAsync/clone/free/count/setGlobal) with per-realm intrinsic isolation",
  "status": "verified",
  "entry_point": "mbjs_init_module",
  "runtime_exports": [
    "clone",
    "count",
    "create",
    "free",
    "run",
    "runAsync",
    "setGlobal"
  ],
  "sources": [
    "native/mochisandbox.c"
  ],
  "headers": [
    "include/mochisandbox_abi.h"
  ],
  "binaries": {
    "x86_64-windows": "lib/mochisandbox_x86_64.dll"
  },
  "js_binding": "node_modules/mochisandbox",
  "engine": "E:/bcf/mochiberry/build_manual/mbjs.exe"
}
