    "include/mochijsnative_abi.h"
  ],
  "binaries": {
    "x86_64-windows": "lib/mochijsnative_x86_64.dll"
  },
  "js_binding": "node_modules/mochijsnative",
  "engine": "E:/bcf/mochiberry/build_manual/mbjs.exe",
  "module_abi": "ms64",
  "host_requirement": "host exe linked with -Wl,--export-all-symbols (or engine as mbjs.dll)"
