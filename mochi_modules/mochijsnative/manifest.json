    "runtimeLimits",
    "contextNew",
    "contextFree",
    "contextStd",
    "valueNew",
    "valueFree",
    "valueType",
    "valueIsException",
    "valueToNumber",
    "valueToInt",
    "valueToString",
    "valueJson",
    "eval",
    "evalModule",
    "detectModule",
    "getException",
    "dumpError",
    "await",
    "loop",
    "callValue",
    "getGlobal",
    "getProp",
    "setProp",
    "jsonParse",
    "jitNew",
    "jitInfo",
    "jitStats",
    "jitCompile",
    "jitInvoke",
    "jitCall",
    "jitCleanup",
    "jitFree",
    "valueDup",
    "valueToBool",
    "valueEq",
